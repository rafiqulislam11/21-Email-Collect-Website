# Auto Lead Collector SaaS - Environment Configuration Example

# Server Configuration
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000/api

# Security & Authentication
JWT_SECRET=lead_collector_super_secret_production_key_2026_change_in_prod
SESSION_SECRET=lead_collector_session_cookie_secret_change_in_prod
CORS_ORIGIN=http://localhost:3000

# Rate Limiting & Concurrency
RATE_LIMIT_MAX_PER_MINUTE=60
RATE_LIMIT_WINDOW_MS=60000
MAX_CONCURRENT_SEARCHES=5
MAX_SEARCH_RESULTS_LIMIT=1000

# Compliance & Privacy Enforcement
STRICT_PUBLIC_DATA_ONLY=true
ENFORCE_COMPLIANCE_CHECKPOINT=true
ENABLE_OPT_OUT_REGISTRY=true

# Data Storage
DATABASE_TYPE=sqlite
DATABASE_FILE=./data/leads.db

# Provider Adapters (Permitted Public Data Sources)
DEFAULT_SEARCH_PROVIDER=public_directory_adapter
ENABLE_MOCK_DEMO_DATA=true
